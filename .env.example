# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection URI (Local or MongoDB Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/ticket_management_db

# JWT Secret Key for Token Generation
JWT_SECRET=your_jwt_secret_key_change_in_production_ticket_system_2026

# Client Application URL (for CORS)
CLIENT_URL=http://localhost:5173

# APP_URL (Platform environment URL)
APP_URL="MY_APP_URL"

